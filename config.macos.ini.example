[user-account]
;配置账号密码，留空则打开网页后需手动登录
username =
password =

[browser-option]
;macOS 默认启动独立 Chrome，EXE_PATH 通常留空
driver = Chrome
EXE_PATH =
;实验性：连接已开启远程调试的日常 Chrome
attachExistingChrome = False
cdpUrl = http://127.0.0.1:9222

[script-option]
;自动滑块只支持登录页
enableAutoCaptcha = False
;可选: 使用 DeepSeek 处理课中单点点击验证，需要单独配置 API Key
enableVisionCaptcha = False
;仅填写在本地配置中，不要提交包含真实 Key 的文件
deepseekApiKey =
enableHideWindow = False
showDonateCode = False

[course-option]
;限制每门课程运行时长/min (不限制:0)
limitMaxTime = 30
limitSpeed = 1.0
soundOff = True

[course-url]
URL1 =
URL2 =
URL3 =
URL4 =
URLn =
